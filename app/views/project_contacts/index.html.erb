<p style="color: green"><%= notice %></p>

<% content_for :title, "Project contacts" %>

<h1>Project contacts</h1>

<div id="project_contacts">
  <% @project_contacts.each do |project_contact| %>
    <%= render project_contact %>
    <p>
      <%= link_to "Show this project contact", project_contact %>
    </p>
  <% end %>
</div>

<%= link_to "New project contact", new_project_contact_path %>
