<div id="<%= dom_id project %>" class="my-5">
  <div class="inline-block p-6 bg-white border border-gray-300 rounded-xl shadow-md space-y-6 space-x-6">

    <!-- Name -->
    <div>
      <strong class="block font-medium mb-1">Name:</strong>
      <%= project.name %>
    </div>

    <!-- Description -->
    <div>
      <strong class="block font-medium mb-1">Description:</strong>
      <%= project.description %>
    </div>

    <!-- Button Group -->
    <div class="flex flex-wrap items-center gap-4">
      <%= link_to "Edit", edit_project_path(project), class: "text-center rounded-md px-5 py-3 bg-gray-100 hover:bg-gray-50 font-medium" %>
      <%= button_to "Destroy Project", project, method: :delete, form_class: "inline", class: "rounded-md px-5 py-3 text-white bg-red-600 hover:bg-red-500 font-medium", data: { turbo_confirm: "Are you sure?" } %>
      <%= link_to "Show Participants", project_participants_path(project), class: "text-center rounded-md px-5 py-3 bg-gray-100 hover:bg-gray-50 font-medium" %>
      <%= link_to 'New Participant', new_project_participant_path(project), class: "text-blue-600 underline font-medium" %>
    </div>

  </div>
</div>




